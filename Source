    function VD(t) { S.vizRAF = requestAnimationFrame(VD); if (document.hidden) return; const w = innerWidth, h = innerHeight; ctx.clearRect(0, 0, w, h); if (!S.vizOn || !S.curAna) return; S.curAna.getByteFrequencyData(S.curDat); const g = w / S.curLen; for (let i = 0, x = 0; i < S.curLen; i++, x += g) { const b = S.curDat[i] * 0.8; if (b > 1) { ctx.save(); ctx.drawImage(GB, 0, 0, 6, 1, x - 2, h - b, 6, b); ctx.globalAlpha = 0.4; ctx.drawImage(GB, 0, 0, 6, 1, x - 2, 0, 6, b / 2); ctx.restore(); } } }
    function VM(t) { S.vizRAF = requestAnimationFrame(VM); if (document.hidden || t - S.vizLf < cfg.fps) return; S.vizLf = t; const w = innerWidth, h = innerHeight; ctx.clearRect(0, 0, w, h); if (!S.vizOn || !S.curAna) return; S.curAna.getByteFrequencyData(S.curDat); const b = Math.min(S.curLen, cfg.bars), s = Math.floor(S.curLen / b), g = w / b; for (let i = 0, x = 0; i < b; i++, x += g) { const bh = S.curDat[i * s] * 0.8; if (bh > 1) { ctx.drawImage(GB, 0, 0, 6, 1, x - 2, h - bh, 6, bh); ctx.globalAlpha = 0.4; ctx.drawImage(GB, 0, 0, 6, 1, x - 2, 0, 6, bh / 2); ctx.globalAlpha = 1; } } }
    function FD(t) { S.vizRAF = requestAnimationFrame(FD); if (document.hidden) return; const w = innerWidth, h = innerHeight; ctx.clearRect(0, 0, w, h); if (!S.vizOn || !AP()) return; S.vizFt += 0.02; const g = w / cfg.bars; for (let i = 0, x = 0; i < cfg.bars; i++, x += g) { const b = (Math.sin(S.vizFt * 2 + i * 0.3) + 1) * 50 + Math.random() * 30; ctx.save(); ctx.drawImage(GB, 0, 0, 6, 1, x - 2, h - b, 6, b); ctx.globalAlpha = 0.4; ctx.drawImage(GB, 0, 0, 6, 1, x - 2, 0, 6, b / 2); ctx.restore(); } }
    function FM(t) { S.vizRAF = requestAnimationFrame(FM); if (document.hidden || t - S.vizLf < cfg.fps) return; S.vizLf = t; const w = innerWidth, h = innerHeight; ctx.clearRect(0, 0, w, h); if (!S.vizOn || !AP()) return; S.vizFt += 0.02; const g = w / cfg.bars; for (let i = 0, x = 0; i < cfg.bars; i++, x += g) { const b = (Math.sin(S.vizFt * 2 + i * 0.3) + 1) * 50 + Math.random() * 30; ctx.drawImage(GB, 0, 0, 6, 1, x - 2, h - b, 6, b); ctx.globalAlpha = 0.4; ctx.drawImage(GB, 0, 0, 6, 1, x - 2, 0, 6, b / 2); ctx.globalAlpha = 1; } }

    // ================================================================
    //  QUEUE
    // ================================================================

    function BQ() { S.sq = cfg.songs.map((_, i) => i); for (let i = S.sq.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [S.sq[i], S.sq[j]] = [S.sq[j], S.sq[i]]; } S.qi = 0; }
    function NSI() { if (S.qi >= S.sq.length) BQ(); return S.sq[S.qi++]; }
    BQ();

    // ================================================================
    //  NOW PLAYING
    // ================================================================

    function GSN(i) { if (i >= 0 && i < cfg.names.length && cfg.names[i]) return cfg.names[i]; try { let n = decodeURIComponent(cfg.songs[i].split('/').pop()).replace(/\.[^.]+$/, ''); return n.length > 30 ? n.slice(0, 30) + '…' : n; } catch { return 'Unknown'; } }
    function UNP(i) { dom.npText.classList.remove('no-scroll'); dom.npText.style.animation = 'none'; dom.npText.textContent = '♪ ' + GSN(i); dom.npText.offsetHeight; dom.npText.style.animation = ''; requestAnimationFrame(() => { dom.npText.classList.toggle('no-scroll', dom.npText.offsetWidth <= dom.npText.parentElement.offsetWidth); }); }
    function UB() { dom.npBars.classList.toggle('paused', dom.music.paused || !S.musicOn); }
    dom.music.addEventListener('play', UB);
    dom.music.addEventListener('pause', UB);
    function UP() { dom.npProg.style.width = (dom.music.duration && isFinite(dom.music.duration)) ? (dom.music.currentTime / dom.music.duration * 100) + '%' : '0%'; S.progRAF = requestAnimationFrame(UP); }
    function SP() { if (S.progRAF) { cancelAnimationFrame(S.progRAF); S.progRAF = null; } }
    dom.music.addEventListener('play', () => { if (!S.progRAF) UP(); });
    dom.music.addEventListener('pause', SP);
    dom.music.addEventListener('ended', () => { dom.npProg.style.width = '0%'; SP(); });

    // ================================================================
    //  PLAYBACK
    // ================================================================

    function PS() { const i = NSI(); dom.music.src = cfg.songs[i]; dom.music.volume = dom.volSlider.value / 100; dom.npProg.style.width = '0%'; UNP(i); if (S.musicOn) dom.music.play().catch(() => {}); }
    dom.music.addEventListener('ended', PS);
    dom.skipBtn.addEventListener('click', PS);

    // ================================================================
    //  HELPERS
    // ================================================================

    function CP(t, el) { (navigator.clipboard ? navigator.clipboard.writeText(t) : new Promise(r => { const a = document.createElement('textarea'); a.value = t; a.style.cssText = 'position:fixed;opacity:0'; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); r(); })).then(() => { el.classList.add('show'); setTimeout(() => el.classList.remove('show'), 1200); }); }
    function IIO() { if (S.iObs || !('IntersectionObserver' in window)) return; S.iObs = new IntersectionObserver(e => { e.forEach(x => { if (!x.isIntersecting) return; const v = x.target.querySelector('video'); if (v && v.dataset.src && !v.src) { v.src = v.dataset.src; v.load(); } S.iObs.unobserve(x.target); }); }, { rootMargin: '200px' }); }
    function BL(l, f, sz) { if (!cfg.mobile || sz >= l.length) { l.forEach(f); return; } let i = 0; (function n() { const e = Math.min(i + sz, l.length); for (; i < e; i++) f(l[i], i); if (i < l.length) setTimeout(n, cfg.batchDelay); })(); }
    function GAV() { return document.querySelectorAll('video'); }
    function SV(v) { dom.music.volume = v; GAV().forEach(x => { x.volume = v; }); }

    // ================================================================
    //  CREATE VIDEO
    // ================================================================

    function MV(src, idx) {
      const w = document.createElement('div');
      w.className = 'vid-wrap loading';
      const v = document.createElement('video');
      v.controls = true; v.crossOrigin = 'anonymous'; v.preload = 'metadata'; v.volume = dom.volSlider.value / 100;
      if (cfg.mobile) { v.playsInline = true; v.setAttribute('playsinline', ''); v.setAttribute('webkit-playsinline', ''); }
      if (S.iObs) { v.dataset.src = src; } else { v.src = src; }
      const a = document.createElement('div'); a.className = 'vid-actions';
      const c = document.createElement('button'); c.className = 'vid-action-btn'; c.textContent = '🔗'; c.title = 'Copy link';
      const d = document.createElement('a'); d.className = 'vid-action-btn'; d.textContent = '⬇'; d.title = 'Download'; d.href = src; d.download = ''; d.target = '_blank';
      a.appendChild(c); a.appendChild(d);
      const il = document.createElement('div'); il.className = 'vid-index'; il.textContent = (idx + 1) + '/' + cfg.videos.length;
      const cn = document.createElement('div'); cn.className = 'vid-copied'; cn.textContent = '✓ Copied!';
      w.appendChild(v); w.appendChild(a); w.appendChild(il); w.appendChild(cn);
      dom.vGrid.appendChild(w);
      c.addEventListener('click', e => { e.stopPropagation(); CP(src, cn); });
      v.addEventListener('loadedmetadata', () => { w.classList.remove('loading'); });
      v.addEventListener('error', () => { w.classList.remove('loading'); w.classList.add('error'); w.innerHTML = '<div class="vid-error-msg">⚠ Failed to load</div>'; const r = document.createElement('button'); r.className = 'vid-retry'; r.textContent = '↻ Retry'; r.addEventListener('click', () => { w.classList.remove('error'); w.classList.add('loading'); w.innerHTML = ''; const nv = document.createElement('video'); nv.src = src; nv.controls = true; nv.crossOrigin = 'anonymous'; nv.preload = 'metadata'; nv.volume = dom.volSlider.value / 100; if (cfg.mobile) { nv.playsInline = true; nv.setAttribute('playsinline', ''); } w.appendChild(nv); w.appendChild(a); w.appendChild(il); w.appendChild(cn); AWV(nv); }); w.appendChild(r); });
      AWV(v);
      if (S.iObs) S.iObs.observe(w);
    }

    function AWV(v) {
      v.addEventListener('play', () => { v.volume = dom.volSlider.value / 100; if (S.musicOn) dom.music.pause(); GAV().forEach(o => { if (o !== v) o.pause(); }); if (!S.vizFallback) SVA(v); UB(); });
      const st = () => { if (![...GAV()].some(x => !x.paused) && S.musicOn) { dom.music.play().catch(() => {}); if (!S.vizFallback) SMA2(); } UB(); };
      v.addEventListener('pause', st);
      v.addEventListener('ended', st);
    }

    // ================================================================
    //  CREATE PHOTO
    // ================================================================

    function MP(src) { const i = document.createElement('img'); i.className = 'photo'; i.src = src; i.alt = 'Photo'; i.loading = 'lazy'; i.decoding = 'async'; dom.pGrid.appendChild(i); i.addEventListener('click', function () { S.pl = [...dom.pGrid.querySelectorAll('img.photo')].map(x => x.src); S.pi = S.pl.indexOf(this.src); if (S.pi === -1) S.pi = 0; OLB(); }); }

    // ================================================================
    //  LOAD / UNLOAD
    // ================================================================

    function LM() { if (S.mediaLoaded) return; S.mediaLoaded = true; IIO(); BL(cfg.videos, MV, cfg.vBatch); BL(cfg.photos, MP, cfg.pBatch); }
    function UM() { GAV().forEach(v => { v.pause(); v.removeAttribute('src'); v.load(); }); dom.vGrid.innerHTML = ''; dom.pGrid.innerHTML = ''; S.mediaLoaded = false; if (S.iObs) { S.iObs.disconnect(); S.iObs = null; } if (S.musicOn) { dom.music.play().catch(() => {}); if (!S.vizFallback) SMA2(); } UB(); }

    // ================================================================
    //  SECTIONS
    // ================================================================

    function CME() { if (!S.memesOpen) return; S.memesOpen = false; dom.mSec.classList.remove('visible'); dom.memesBtn.classList.remove('active'); setTimeout(() => { if (!S.memesOpen) UM(); }, 500); }
    function CWS() { if (!S.websitesOpen) return; S.websitesOpen = false; dom.wSec.classList.remove('visible'); dom.websitesBtn.classList.remove('active'); }
    dom.memesBtn.addEventListener('click', function () { if (!S.memesOpen) { CWS(); S.memesOpen = true; LM(); dom.mSec.classList.add('visible'); this.classList.add('active'); } else { CME(); } });
    dom.websitesBtn.addEventListener('click', function () { if (!S.websitesOpen) { CME(); S.websitesOpen = true; dom.wSec.classList.add('visible'); this.classList.add('active'); } else { CWS(); } });

    // ================================================================
    //  TOOLBAR
    // ================================================================

    dom.volSlider.addEventListener('input', function () { SV(this.value / 100); LS.set('musicVolume', this.value); });
    dom.toggleMusic.addEventListener('click', function () { S.musicOn = !S.musicOn; if (!S.musicOn) { dom.music.pause(); this.textContent = '♫ Music: OFF'; this.classList.add('off'); } else { if (![...GAV()].some(v => !v.paused)) { dom.music.play().catch(() => {}); } this.textContent = '♫ Music: ON'; this.classList.remove('off'); } LS.set('musicEnabled', S.musicOn); UB(); });
    dom.toggleViz.addEventListener('click', function () { S.vizOn = !S.vizOn; if (!S.vizOn) { ctx.clearRect(0, 0, dom.canvas.width, dom.canvas.height); this.textContent = '◈ Visualizer: OFF'; this.classList.add('off'); } else { this.textContent = '◈ Visualizer: ON'; this.classList.remove('off'); } LS.set('visualizerEnabled', S.vizOn); });
    dom.toggleSnow.addEventListener('click', function () { S.snowOn = !S.snowOn; if (!S.snowOn) { dom.snowEl.classList.add('hidden'); this.textContent = '❄ Snow: OFF'; this.classList.add('off'); } else { dom.snowEl.classList.remove('hidden'); this.textContent = '❄ Snow: ON'; this.classList.remove('off'); } LS.set('snowEnabled', S.snowOn); });

    // ================================================================
    //  ENTER
    // ================================================================

    dom.enterScreen.addEventListener('click', () => { dom.enterScreen.classList.add('fade-out'); setTimeout(() => { dom.enterScreen.style.display = 'none'; }, 600); PS(); if (S.musicOn) { dom.music.play().then(SVZ).catch(SVZ); } else { SVZ(); } });

    // ================================================================
    //  LIGHTBOX
    // ================================================================

    function OLB() { RLZ(); SLI(); dom.lightbox.classList.add('active'); document.body.style.overflow = 'hidden'; if (!S.hs) { dom.lbHint.style.opacity = '1'; dom.lbHint.textContent = cfg.mobile ? 'swipe to navigate • double-tap to zoom' : 'click to zoom • drag to pan • ← → navigate'; setTimeout(() => { dom.lbHint.style.opacity = '0'; }, 3000); S.hs = true; } }
    function SLI() { if (S.pi < 0 || S.pi >= S.pl.length) return; clearTimeout(S.ilt); dom.lbLoad.classList.remove('visible'); S.ilt = setTimeout(() => dom.lbLoad.classList.add('visible'), 150); dom.lbImg.style.opacity = '0'; dom.lbImg.src = S.pl[S.pi]; RLZ(); ULC(); ULNV(); PLA(); }
    dom.lbImg.addEventListener('load', () => { clearTimeout(S.ilt); dom.lbLoad.classList.remove('visible'); dom.lbImg.style.opacity = '1'; const r = dom.lbImg.getBoundingClientRect(); S.iw = r.width; S.ih = r.height; });
    dom.lbImg.addEventListener('error', () => { clearTimeout(S.ilt); dom.lbLoad.classList.remove('visible'); dom.lbImg.style.opacity = '1'; });
    function ULC() { dom.lbCount.textContent = (S.pi + 1) + ' / ' + S.pl.length; }
    function ULNV() { const h = S.zoomed || S.pl.length < 2; dom.lbPrev.classList.toggle('lb-hidden', h); dom.lbNext.classList.toggle('lb-hidden', h); dom.lbCount.style.opacity = S.zoomed ? '0' : '1'; }
    function PLA() { [S.pi + 1, S.pi - 1].forEach(i => { if (i >= 0 && i < S.pl.length) { const img = new Image(); img.src = S.pl[i]; } }); }
    function PP() { if (S.zoomed || S.pl.length < 2) return; S.pi = (S.pi - 1 + S.pl.length) % S.pl.length; SLI(); }
    function NP() { if (S.zoomed || S.pl.length < 2) return; S.pi = (S.pi + 1) % S.pl.length; SLI(); }
    function CLB() { dom.lightbox.classList.remove('active'); dom.lbImg.src = ''; document.body.style.overflow = ''; RLZ(); clearTimeout(S.ilt); dom.lbLoad.classList.remove('visible'); }
    dom.lbClose.addEventListener('click', CLB);
    dom.lbPrev.addEventListener('click', e => { e.stopPropagation(); PP(); });
    dom.lbNext.addEventListener('click', e => { e.stopPropagation(); NP(); });
    dom.lightbox.addEventListener('click', e => { if (e.target === dom.lightbox) CLB(); });
    document.addEventListener('keydown', e => { if (!dom.lightbox.classList.contains('active')) return; if (e.key === 'Escape') CLB(); else if (e.key === 'ArrowLeft') PP(); else if (e.key === 'ArrowRight') NP(); });

    // ================================================================
    //  LIGHTBOX ZOOM & PAN
    // ================================================================

    const ZL = 2.5;
    function CLP(z) { const mx = Math.max(0, (S.iw * z - innerWidth) / 2), my = Math.max(0, (S.ih * z - innerHeight) / 2); S.tx = Math.min(mx, Math.max(-mx, S.tx)); S.ty = Math.min(my, Math.max(-my, S.ty)); }
    function AT(z, tr) { dom.lbImg.style.transition = tr ? 'transform 0.3s ease' : 'none'; dom.lbImg.style.transform = `scale(${z}) translate(${S.tx / z}px,${S.ty / z}px)`; }
    function ZIA(cx, cy) { const r = dom.lbImg.getBoundingClientRect(); S.iw = r.width; S.ih = r.height; const px = (cx - r.left) / r.width, py = (cy - r.top) / r.height; S.tx = -(px - 0.5) * r.width * (ZL - 1); S.ty = -(py - 0.5) * r.height * (ZL - 1); S.zl = ZL; CLP(ZL); S.lx = S.tx; S.ly = S.ty; AT(ZL, true); dom.lbImg.classList.add('zoomed'); S.zoomed = true; ULNV(); dom.lbHint.style.opacity = '0'; }
    dom.lbImg.addEventListener('click', function (e) { if (S.dragDet) { S.dragDet = false; return; } e.stopPropagation(); S.zoomed ? RLZ() : ZIA(e.clientX, e.clientY); });
    dom.lbImg.addEventListener('mousedown', function (e) { if (!S.zoomed) return; e.preventDefault(); S.dragging = true; S.dragDet = false; S.sx = e.clientX; S.sy = e.clientY; this.style.transition = 'none'; this.style.willChange = 'transform'; this.classList.add('dragging'); });
    const OMM = th(e => { if (!S.dragging) return; const dx = e.clientX - S.sx, dy = e.clientY - S.sy; if (Math.abs(dx) > 5 || Math.abs(dy) > 5) S.dragDet = true; S.tx = S.lx + dx; S.ty = S.ly + dy; CLP(S.zl); AT(S.zl, false); }, 16);
    document.addEventListener('mousemove', OMM);
    document.addEventListener('mouseup', () => { if (!S.dragging) return; S.dragging = false; S.lx = S.tx; S.ly = S.ty; dom.lbImg.style.willChange = ''; dom.lbImg.classList.remove('dragging'); });
    function GTD(t) { const dx = t[0].clientX - t[1].clientX, dy = t[0].clientY - t[1].clientY; return Math.sqrt(dx * dx + dy * dy); }
    dom.lbImg.addEventListener('touchstart', function (e) { if (e.touches.length === 2) { S.pd = GTD(e.touches); S.pz = S.zl; S.dragging = false; S.sw = false; S.pa = true; return; } if (e.touches.length !== 1) return; const n = Date.now(); if (n - S.ltt < 300) { S.ltt = 0; S.zoomed ? RLZ() : ZIA(e.touches[0].clientX, e.touches[0].clientY); return; } S.ltt = n; if (S.zoomed) { S.dragging = true; S.dragDet = false; S.sx = e.touches[0].clientX; S.sy = e.touches[0].clientY; this.style.transition = 'none'; this.style.willChange = 'transform'; S.sw = false; } else { S.sw = true; S.dragging = false; S.swx = e.touches[0].clientX; S.swy = e.touches[0].clientY; } }, { passive: true });
    const OTM = th(e => { if (e.touches.length === 2 && S.pa) { const n = GTD(e.touches), z = (n / S.pd) * S.pz; S.zl = Math.min(Math.max(z, 0.8), 5); S.zoomed = S.zl > 1.05; CLP(S.zl); AT(S.zl, false); S.zoomed ? dom.lbImg.classList.add('zoomed') : dom.lbImg.classList.remove('zoomed'); ULNV(); } else if (S.dragging && e.touches.length === 1) { const dx = e.touches[0].clientX - S.sx, dy = e.touches[0].clientY - S.sy; if (Math.abs(dx) > 5 || Math.abs(dy) > 5) S.dragDet = true; S.tx = S.lx + dx; S.ty = S.ly + dy; CLP(S.zl); AT(S.zl, false); } }, 16);
    document.addEventListener('touchmove', OTM, { passive: true });
    document.addEventListener('touchend', e => { if (S.dragging) { S.dragging = false; S.lx = S.tx; S.ly = S.ty; dom.lbImg.style.willChange = ''; } if (S.pa && e.touches.length < 2) { S.pa = false; S.pd = 0; if (S.zl < 1.05) RLZ(); return; } if (S.sw && !S.pa && e.changedTouches.length === 1) { S.sw = false; const dx = e.changedTouches[0].clientX - S.swx, dy = e.changedTouches[0].clientY - S.swy; if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) { dx > 0 ? PP() : NP(); } } });
    function RLZ() { S.zoomed = S.dragging = S.dragDet = S.sw = S.pa = false; S.tx = S.ty = S.lx = S.ly = 0; S.zl = 1; S.pd = 0; dom.lbImg.style.willChange = ''; AT(1, true); dom.lbImg.classList.remove('zoomed', 'dragging'); ULNV(); }

  })();
  </script>
