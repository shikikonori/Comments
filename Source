<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shikikonori</title>

  <style>
    /* ============ RESET & BASE ============ */
    * { -webkit-tap-highlight-color: transparent; }

    body {
      background-color: black;
      color: white;
      margin: 0;
      padding: 20px;
      font-family: 'Cascadia Mono', monospace;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    p, h1, h2 { text-align: center; }

    /* ============ ENTER SCREEN ============ */
    .enter-screen {
      position: fixed;
      inset: 0;
      background: black;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      cursor: pointer;
      overflow: hidden;
      transition: opacity 0.6s ease;
    }

    .enter-screen.fade-out { opacity: 0; pointer-events: none; }

    .enter-bg-glow {
      position: absolute;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,0,0,0.15) 0%, transparent 70%);
      animation: enter-glow-pulse 3s ease-in-out infinite;
      pointer-events: none;
    }

    .enter-title {
      font-family: 'Cascadia Mono', monospace;
      font-size: 2.5em;
      color: white;
      letter-spacing: 8px;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
      animation: enter-title-float 3s ease-in-out infinite;
      text-shadow: 0 0 10px rgba(255,255,255,0.3), 0 0 30px rgba(255,0,0,0.2), 0 0 60px rgba(255,0,0,0.1);
    }

    .enter-line {
      width: 60px;
      height: 1px;
      margin-top: 15px;
      position: relative;
      z-index: 1;
      background: linear-gradient(90deg, transparent, rgba(255,0,0,0.6), transparent);
      animation: enter-line-expand 2.5s ease-in-out infinite;
    }

    .enter-subtitle {
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.75em;
      color: rgba(255,255,255,0.3);
      margin-top: 20px;
      position: relative;
      z-index: 1;
      animation: enter-blink 2s ease-in-out infinite;
      letter-spacing: 3px;
    }

    .enter-particles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }

    .enter-particle {
      position: absolute;
      width: 2px;
      height: 2px;
      background: rgba(255,0,0,0.4);
      border-radius: 50%;
      animation: enter-particle-drift linear infinite;
    }

    @keyframes enter-glow-pulse {
      0%, 100% { transform: scale(1); opacity: 0.5; }
      50%      { transform: scale(1.4); opacity: 0.8; }
    }
    @keyframes enter-title-float {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }
    @keyframes enter-line-expand {
      0%, 100% { width: 60px; opacity: 0.4; }
      50%      { width: 120px; opacity: 0.9; }
    }
    @keyframes enter-blink {
      0%, 100% { opacity: 0.3; }
      50%      { opacity: 0.8; }
    }
    @keyframes enter-particle-drift {
      0%   { transform: translateY(100vh) scale(0); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { transform: translateY(-10vh) scale(1.5); opacity: 0; }
    }

    .enter-particle:nth-child(1)  { left: 5%;  animation: enter-particle-drift 6s linear 0s infinite; }
    .enter-particle:nth-child(2)  { left: 15%; animation: enter-particle-drift 8s linear 1s infinite; }
    .enter-particle:nth-child(3)  { left: 25%; animation: enter-particle-drift 5s linear 0.5s infinite; }
    .enter-particle:nth-child(4)  { left: 35%; animation: enter-particle-drift 7s linear 2s infinite; }
    .enter-particle:nth-child(5)  { left: 45%; animation: enter-particle-drift 9s linear 1.5s infinite; }
    .enter-particle:nth-child(6)  { left: 55%; animation: enter-particle-drift 6s linear 3s infinite; }
    .enter-particle:nth-child(7)  { left: 65%; animation: enter-particle-drift 8s linear 0.8s infinite; }
    .enter-particle:nth-child(8)  { left: 75%; animation: enter-particle-drift 5s linear 2.5s infinite; }
    .enter-particle:nth-child(9)  { left: 85%; animation: enter-particle-drift 7s linear 1.2s infinite; }
    .enter-particle:nth-child(10) { left: 95%; animation: enter-particle-drift 6s linear 3.5s infinite; }
    .enter-particle:nth-child(11) { left: 10%; animation: enter-particle-drift 9s linear 4s infinite; }
    .enter-particle:nth-child(12) { left: 30%; animation: enter-particle-drift 5.5s linear 0.3s infinite; }
    .enter-particle:nth-child(13) { left: 50%; animation: enter-particle-drift 7.5s linear 2.2s infinite; }
    .enter-particle:nth-child(14) { left: 70%; animation: enter-particle-drift 6.5s linear 1.8s infinite; }
    .enter-particle:nth-child(15) { left: 90%; animation: enter-particle-drift 8.5s linear 3.2s infinite; }

    /* ============ TOOLBAR ============ */
    .toolbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
      background: rgba(0,0,0,0.8);
      border-bottom: 1px solid rgba(255,255,255,0.1);
      z-index: 9998;
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
    }

    .toolbar button {
      background: rgba(50,255,50,0.15);
      color: rgba(100,255,100,1);
      border: 1px solid rgba(50,255,50,0.3);
      padding: 2px 8px;
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.65em;
      cursor: pointer;
      border-radius: 3px;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
      user-select: none;
    }

    .toolbar button:hover { background: rgba(50,255,50,0.25); border-color: rgba(50,255,50,0.5); }
    .toolbar button.off { background: rgba(255,50,50,0.2); border-color: rgba(255,50,50,0.4); color: rgba(255,100,100,1); }
    .toolbar button.off:hover { background: rgba(255,50,50,0.3); }

    /* ============ NOW PLAYING ============ */
    .now-playing {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 2px 8px;
      border: 1px solid rgba(255,0,0,0.2);
      border-radius: 3px;
      background: rgba(255,0,0,0.05);
      max-width: 280px;
      overflow: hidden;
      position: relative;
    }

    .np-bars { display: flex; align-items: flex-end; gap: 1.5px; height: 12px; flex-shrink: 0; }

    .np-bar {
      width: 2px;
      background: #ff4444;
      border-radius: 1px;
      animation: np-bar-bounce 1s ease-in-out infinite;
    }

    .np-bar:nth-child(1) { height: 4px;  animation-delay: 0s;    }
    .np-bar:nth-child(2) { height: 8px;  animation-delay: 0.15s; }
    .np-bar:nth-child(3) { height: 5px;  animation-delay: 0.3s;  }
    .np-bar:nth-child(4) { height: 10px; animation-delay: 0.45s; }
    .np-bar:nth-child(5) { height: 6px;  animation-delay: 0.6s;  }

    @keyframes np-bar-bounce {
      0%, 100% { transform: scaleY(0.3); }
      50%      { transform: scaleY(1); }
    }

    .np-bars.paused .np-bar { animation-play-state: paused; transform: scaleY(0.3); }

    .np-text-wrapper { overflow: hidden; flex: 1; position: relative; height: 14px; min-width: 80px; }

    .np-text {
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.55em;
      color: rgba(255,100,100,0.9);
      white-space: nowrap;
      position: absolute;
      top: 1px;
      left: 0;
      animation: np-scroll 12s linear infinite;
      text-shadow: 0 0 4px rgba(255,0,0,0.3);
    }

    .np-text.no-scroll { animation: none; position: relative; }

    @keyframes np-scroll {
      0%   { transform: translateX(100%); }
      100% { transform: translateX(-100%); }
    }

    .np-controls {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-shrink: 0;
    }

    .np-skip {
      background: none;
      border: none;
      color: rgba(255,100,100,0.7);
      font-size: 0.7em;
      cursor: pointer;
      padding: 0 2px;
      font-family: 'Cascadia Mono', monospace;
      transition: color 0.15s, transform 0.1s;
      user-select: none;
      line-height: 1;
    }

    .np-skip:hover { color: rgba(255,100,100,1); }
    .np-skip:active { transform: scale(0.85); }

    .np-vol-label {
      font-size: 0.65em;
      color: rgba(255,255,255,0.6);
      user-select: none;
    }

    .np-vol-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 50px;
      height: 3px;
      background: rgba(255,255,255,0.15);
      border-radius: 2px;
      outline: none;
      cursor: pointer;
      margin: 0;
      padding: 0;
    }

    .np-vol-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 8px;
      height: 8px;
      background: rgba(100,255,100,0.8);
      border-radius: 50%;
      cursor: pointer;
      transition: background 0.2s;
    }

    .np-vol-slider::-webkit-slider-thumb:hover { background: rgba(100,255,100,1); }

    .np-vol-slider::-moz-range-thumb {
      width: 8px;
      height: 8px;
      background: rgba(100,255,100,0.8);
      border-radius: 50%;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }

    .np-vol-slider::-moz-range-track {
      background: transparent;
      border: none;
    }

    .np-progress {
      position: absolute;
      bottom: 0;
      left: 0;
      height: 1px;
      background: rgba(255,80,80,0.6);
      border-radius: 0 0 3px 3px;
      transition: width 0.3s linear;
      width: 0%;
    }

    /* ============ TITLE ============ */
    .title-gif { display: block; margin: 0 auto; height: 60px; width: auto; }

    /* ============ CONTENT ============ */
    .content { position: relative; z-index: 2; width: 85%; margin: 0 auto; padding-top: 25px; }

    /* ============ TEXT BOX ============ */
    .text-box-container { display: flex; justify-content: center; margin: 15px auto; }

    .text-box {
      width: 70%;
      background: rgba(0,0,0,0.86);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 4px;
      color: #ff3333;
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.85em;
      padding: 15px 20px;
      line-height: 1.6;
      text-align: center;
      text-shadow: 0 0 5px rgba(255,0,0,0.5), 0 0 10px rgba(255,0,0,0.4), 0 0 20px rgba(255,0,0,0.3), 0 0 40px rgba(255,0,0,0.2);
      animation: glow-pulse 2s ease-in-out infinite;
    }

    @keyframes glow-pulse {
      0%, 100% { text-shadow: 0 0 5px rgba(255,0,0,0.5), 0 0 10px rgba(255,0,0,0.4), 0 0 20px rgba(255,0,0,0.3), 0 0 40px rgba(255,0,0,0.2); }
      50%      { text-shadow: 0 0 10px rgba(255,0,0,0.8), 0 0 20px rgba(255,0,0,0.6), 0 0 40px rgba(255,0,0,0.4), 0 0 60px rgba(255,0,0,0.3); }
    }

    .box-image { width: 300px; height: auto; }

    .link-boxes { display: flex; justify-content: center; gap: 8px; margin-top: 12px; flex-wrap: wrap; }

    .link-box {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,0,0,0.3);
      border-radius: 3px;
      padding: 4px 12px;
      color: #ff3333;
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.75em;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, transform 0.2s;
      text-shadow: 0 0 5px rgba(255,0,0,0.3), 0 0 10px rgba(255,0,0,0.2);
      display: inline-block;
    }

    .link-box:hover { background: rgba(255,0,0,0.15); border-color: rgba(255,0,0,0.6); transform: scale(1.05); }

    .glow-divider {
      width: 80%;
      height: 1px;
      margin: 14px auto 12px auto;
      border: none;
      background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.1) 15%, rgba(255,255,255,0.6) 50%, rgba(255,255,255,0.1) 85%, transparent 100%);
      box-shadow: 0 0 6px rgba(255,255,255,0.3), 0 0 15px rgba(255,255,255,0.15), 0 0 30px rgba(255,255,255,0.08);
      animation: divider-glow 3s ease-in-out infinite;
    }

    @keyframes divider-glow {
      0%, 100% { box-shadow: 0 0 6px rgba(255,255,255,0.3), 0 0 15px rgba(255,255,255,0.15), 0 0 30px rgba(255,255,255,0.08); opacity: 0.8; }
      50%      { box-shadow: 0 0 8px rgba(255,255,255,0.5), 0 0 20px rgba(255,255,255,0.25), 0 0 40px rgba(255,255,255,0.12); opacity: 1; }
    }

    .action-buttons { display: flex; justify-content: center; gap: 8px; }

    .action-btn {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,0,0,0.3);
      border-radius: 3px;
      padding: 5px 18px;
      color: #ff3333;
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.8em;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, transform 0.2s;
      text-shadow: 0 0 5px rgba(255,0,0,0.3), 0 0 10px rgba(255,0,0,0.2);
      user-select: none;
      letter-spacing: 0.5px;
    }

    .action-btn:hover { background: rgba(255,0,0,0.15); border-color: rgba(255,0,0,0.6); transform: scale(1.05); }
    .action-btn.active { background: rgba(255,0,0,0.2); border-color: rgba(255,0,0,0.8); }

    /* ============ SECTIONS ============ */
    .toggled-section { opacity: 0; max-height: 0; overflow: hidden; transition: opacity 0.4s, max-height 0.5s; pointer-events: none; }
    .toggled-section.visible { opacity: 1; max-height: 50000px; pointer-events: all; }

    .websites-content { display: flex; justify-content: center; margin-top: 15px; }

    .websites-box {
      width: 80%;
      background: rgba(0,0,0,0.7);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 4px;
      padding: 20px 25px;
      text-align: center;
    }

    .websites-box h2 {
      margin: 0 0 15px 0;
      font-size: 1.1em;
      color: #ff5555;
      font-family: 'Cascadia Mono', monospace;
      text-shadow: 0 0 8px rgba(255,0,0,0.5), 0 0 15px rgba(255,0,0,0.3);
    }

    .websites-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }

    .website-link {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,0,0,0.25);
      border-radius: 3px;
      padding: 8px 16px;
      color: #ff4444;
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.78em;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, transform 0.2s;
      text-shadow: 0 0 4px rgba(255,0,0,0.3), 0 0 8px rgba(255,0,0,0.15);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .website-link:hover { background: rgba(255,0,0,0.12); border-color: rgba(255,0,0,0.5); transform: scale(1.05); }
    .website-link .site-icon { font-size: 1.1em; }

    /* ============ MEDIA GRID ============ */
    .center-container { display: flex; gap: 0; margin-top: 10px; align-items: flex-start; }
    .column { flex: 1; padding: 0 2px; }
    .media-grid { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; align-items: flex-start; }

    /* ============ VIDEO WRAPPER ============ */
    .vid-wrap {
      width: 48%;
      position: relative;
      background: #111;
      flex-shrink: 0;
      border-radius: 2px;
      overflow: hidden;
    }

    .vid-wrap video { width: 100%; height: auto; display: block; }

    .vid-wrap.loading { min-height: 120px; animation: vid-skeleton 1.5s ease-in-out infinite; }

    @keyframes vid-skeleton {
      0%, 100% { background: #111; }
      50%      { background: #1a1a1a; }
    }

    .vid-wrap.error {
      min-height: 80px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .vid-error-msg {
      color: rgba(255,80,80,0.6);
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.65em;
      text-align: center;
    }

    .vid-retry {
      background: rgba(255,50,50,0.15);
      border: 1px solid rgba(255,50,50,0.3);
      border-radius: 3px;
      color: rgba(255,100,100,0.8);
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.6em;
      padding: 3px 10px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .vid-retry:hover { background: rgba(255,50,50,0.3); }

    .vid-actions {
      position: absolute;
      top: 4px;
      right: 4px;
      display: flex;
      gap: 3px;
      opacity: 0;
      transition: opacity 0.2s;
      z-index: 2;
    }

    .vid-wrap:hover .vid-actions { opacity: 1; }

    .vid-action-btn {
      background: rgba(0,0,0,0.7);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 2px;
      color: rgba(255,255,255,0.7);
      font-size: 0.65em;
      padding: 2px 5px;
      cursor: pointer;
      font-family: 'Cascadia Mono', monospace;
      transition: background 0.15s, color 0.15s;
      user-select: none;
      line-height: 1;
      text-decoration: none;
    }

    .vid-action-btn:hover { background: rgba(255,0,0,0.3); color: white; }

    .vid-index {
      position: absolute;
      bottom: 4px;
      left: 4px;
      background: rgba(0,0,0,0.7);
      color: rgba(255,255,255,0.4);
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.55em;
      padding: 1px 5px;
      border-radius: 2px;
      pointer-events: none;
      z-index: 2;
    }

    .vid-copied {
      position: absolute;
      bottom: 4px;
      right: 4px;
      background: rgba(0,0,0,0.85);
      color: rgba(100,255,100,0.9);
      font-family: 'Cascadia Mono', monospace;
      font-size: 0.65em;
      padding: 3px 8px;
      border-radius: 3px;
      opacity: 0;
      transition: opacity 0.2s;
      pointer-events: none;
      z-index: 3;
    }

    .vid-copied.show { opacity: 1; }

    /* ============ PHOTOS ============ */
    img.photo {
      width: 48%; height: auto; display: block; background: #111;
      flex-shrink: 0; cursor: pointer; transition: transform 0.2s, opacity 0.2s;
      object-fit: cover; align-self: flex-start;
    }

    img.photo:hover { transform: scale(1.03); opacity: 0.8; }

    /* ============ LIGHTBOX ============ */
    .lightbox {
      position: fixed; inset: 0; background: rgba(0,0,0,0.95);
      display: none; justify-content: center; align-items: center;
      z-index: 10000; cursor: pointer; padding: 20px; box-sizing: border-box; overflow: hidden;
    }

    .lightbox.active { display: flex; }

    .lightbox-img-wrapper {
      position: relative;
      max-width: 90%;
      max-height: 90vh;
      overflow: hidden;
      cursor: default;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .lightbox-img-wrapper img {
      display: block; max-width: 90vw; max-height: 90vh; transform-origin: center;
      transition: transform 0.3s ease, opacity 0.2s ease;
      user-select: none; -webkit-user-drag: none; touch-action: none;
    }

    .lightbox-img-wrapper img.zoomed { cursor: grab; transition: none; }
    .lightbox-img-wrapper img.zoomed.dragging { cursor: grabbing; }

    .lightbox-close {
      position: fixed; top: 15px; right: 20px; color: white; font-size: 36px;
      font-family: 'Cascadia Mono', monospace; cursor: pointer; z-index: 10002;
      user-select: none; transition: opacity 0.2s;
      width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
    }

    .lightbox-close:hover { opacity: 0.6; }

    .lightbox-nav {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255,255,255,0.6);
      font-size: 2em;
      font-family: 'Cascadia Mono', monospace;
      cursor: pointer;
      z-index: 10002;
      user-select: none;
      transition: color 0.2s, opacity 0.3s;
      padding: 15px 10px;
      background: rgba(0,0,0,0.3);
      border-radius: 4px;
    }

    .lightbox-nav:hover { color: rgba(255,255,255,1); }
    .lightbox-nav.lb-prev { left: 10px; }
    .lightbox-nav.lb-next { right: 10px; }
    .lightbox-nav.lb-hidden { opacity: 0; pointer-events: none; }

    .lightbox-counter {
      position: fixed; top: 18px; left: 50%; transform: translateX(-50%);
      color: rgba(255,255,255,0.4); font-family: 'Cascadia Mono', monospace;
      font-size: 0.75em; z-index: 10002; user-select: none; pointer-events: none;
      transition: opacity 0.3s;
    }

    .lightbox-hint {
      position: fixed; bottom: 25px; left: 50%; transform: translateX(-50%);
      color: rgba(255,255,255,0.4); font-family: 'Cascadia Mono', monospace;
      font-size: 0.75em; z-index: 10002; user-select: none; pointer-events: none;
      transition: opacity 0.3s;
    }

    .lightbox-loader {
      position: absolute;
      width: 30px; height: 30px;
      border: 2px solid rgba(255,255,255,0.1);
      border-top: 2px solid rgba(255,100,100,0.8);
      border-radius: 50%;
      animation: lb-spin 0.8s linear infinite;
      z-index: 1;
      display: none;
    }

    .lightbox-loader.visible { display: block; }

    @keyframes lb-spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* ============ VISUALIZER ============ */
    #visualizer { position: fixed; inset: 0; z-index: 0; pointer-events: none; }

    /* ============ SNOWFLAKES ============ */
